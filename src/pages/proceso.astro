---
import Layout from '../layouts/Layout.astro'
import TitleCoffee from '../components/TitleCoffee.astro'
import CoffeProcess from '../components/CoffeProcess.astro'
---

<Layout title='Procesos' bg='/cafe/header_proceso.jpg' titleHeader='los verdaderos expertos del café' paginaActual='/proceso'>
    <main class="contenedor up">
        <TitleCoffee cont1='nuestro' cont2='proceso'/>
        <section>
            <CoffeProcess title='Granos de cafe' description='Seleccionamos los mejores granos de café, cuidadosamente cultivados y recolectados para garantizar un sabor excepcional.' image='/cafe/proceso_1.jpg'/>
            <CoffeProcess title='Tostar el cafe' description='Tostamos los granos a la perfección, resaltando sus aromas y matices únicos para una experiencia inigualable.' image='/cafe/proceso_2.jpg'/>
            <CoffeProcess title='Empacar el café' description='Empacamos el café recién tostado para conservar su frescura y calidad hasta llegar a tu taza.' image='/cafe/proceso_3.jpg'/>
            <CoffeProcess title='Moler los granos del cafe' description='Molemos los granos justo antes de preparar tu bebida, asegurando el máximo sabor y aroma.' image='/cafe/proceso_4.jpg'/>
            <CoffeProcess title='Disfrutar una taza' description='Finalmente, disfruta de una taza de café con el mejor sabor, aroma y calidad que solo nosotros te ofrecemos.' image='/cafe/proceso_5.jpg'/>
        </section>
    </main>
</Layout>